        const hashedPassword = await bcrypt.hash(password, 10);

        await db('users')
            .where('username', 'admin')
            .update({ password_hash: hashedPassword });

        console.log(`Password for 'admin' user has been reset to: ${password}`);
        process.exit(0);
    } catch (error) {
