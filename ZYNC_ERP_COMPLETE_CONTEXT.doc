/* POS Component Styles */
/* ============================================
   DESIGN TOKENS - Visual States
   ============================================ */
:root {
    /* State Colors */
    --pos-color-neutral: rgba(255, 255, 255, 0.05);
    --pos-color-selected: rgba(59, 130, 246, 0.15);
    --pos-color-in-cart: rgba(16, 185, 129, 0.12);
    --pos-color-low-stock: rgba(251, 191, 36, 0.12);
    --pos-color-out-stock: rgba(239, 68, 68, 0.08);
    --pos-color-flash: rgba(59, 130, 246, 0.4);

    /* Accent Colors */
    --pos-accent-selected: #3b82f6;
    --pos-accent-in-cart: #10b981;
    --pos-accent-warning: #fbbf24;
    --pos-accent-danger: #ef4444;

    /* Animation Timing */
    --pos-timing-flash: 400ms;
    --pos-timing-transition: 150ms;
    --pos-timing-pulse: 2s;
}

/* ============================================
   PRODUCT CARD (Refactored Status Strip Design)
   ============================================ */
.product-card {
    padding: var(--space-3);
    padding-left: 14px;
    /* Space from status strip */
    background: #1e293b;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all var(--pos-timing-transition) ease;
    text-align: left;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0;
    /* Managed by spacers */
    min-height: 140px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
}

/* Straight Status Strip - Using ::before for clean slice */
.product-card::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 6px;
    /* 6px wide strip */
    background: transparent;
    transition: background-color 0.2s;
}

/* Status Strips */
.product-card.in-stock::before {
    background-color: #10b981;
}

.product-card.low-stock::before {
    background-color: #f59e0b;
}

.product-card.out-of-stock::before {
    background-color: #ef4444;
}

/* Remove old border-left approach to ensure corner slice */
.product-card {
    border-left: none;
}

/* Default hover - Lighten background */
.product-card:hover:not(:disabled) {
    background: #2a384e;
    /* Lighter dark */
    transform: translateY(-2px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
}

/* Focus visible */
.product-card:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.5);
}

/* Selected state */
.product-card.selected {
    background: #2a384e;
    box-shadow: inset 0 0 0 1px rgba(59, 130, 246, 0.5);
}

/* In-cart state - Subtle background tint */
.product-card.in-cart {
    background: linear-gradient(to right bottom, #1e293b, rgba(16, 185, 129, 0.05));
    box-shadow: inset 0 0 0 1px rgba(16, 185, 129, 0.2);
}

/* Out of stock - Dimmed */
.product-card.out-of-stock {
    opacity: 0.7;
    filter: grayscale(10%);
}

.product-card.out-of-stock:not(:disabled):hover {
    opacity: 0.9;
}

.product-card.out-of-stock:disabled {
    cursor: not-allowed;
    opacity: 0.6;
}

/* Just-added flash animation */
.product-card.just-added {
    animation: card-flash 400ms ease-out;
}

@keyframes card-flash {
    0% {
        transform: scale(1.02);
        background: rgba(59, 130, 246, 0.2);
    }

    100% {
        transform: scale(1);
        background: #1e293b;
    }
}

/* CARD LAYOUT CONTAINERS */
.card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 4px;
}

.card-footer {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    /* Align baseline */
}

/* ============================================
    IN-CART PILL - Strong visual indicator
    ============================================ */
.in-cart-pill {
    position: static;
    /* Flex managed */
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    background: #10b981;
    color: white;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
    box-shadow: 0 2px 6px rgba(16, 185, 129, 0.4);
    height: 24px;
}

.in-cart-pill .pill-icon {
    font-size: 0.7rem;
}

.in-cart-pill .pill-qty {
    font-family: var(--font-mono);
    min-width: 14px;
    text-align: center;
}

/* Old badge - deprecated, kept for compatibility */
.cart-qty-badge {
    display: none;
}

/* Product Name */
.product-name {
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.35;
    color: #f1f5f9;
    flex: 1;
    /* Take up left space */
    min-width: 0;
    /* Allow limiting constraints */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

/* SKU / Code */
.product-code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #64748b;
    margin-bottom: 8px;
}

/* Price - White, Bold, Larger */
.product-price {
    font-family: var(--font-mono);
    font-weight: 700;
    color: #ffffff;
    font-size: 1.25rem;
    letter-spacing: -0.5px;
    line-height: 1;
    /* Tighten line height for baseline alignment */
}

.product-price .price-label {
    display: none;
    /* Hide 'Price:' label for cleaner look */
}

/* Stock Badge - Top Right Pill */
.stock-badge {
    position: static;
    /* Flex managed */
    flex-shrink: 0;
    /* Don't shrink */
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 0.7rem;
    font-family: var(--font-sans);
    font-weight: 600;
}

.stock-badge.in-stock {
    display: none;
    /* Hide if healthy to reduce noise */
}

.stock-badge.low-stock {
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.3);
    background: rgba(251, 191, 36, 0.1);
}

.stock-badge.out-of-stock {
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.3);
    background: rgba(239, 68, 68, 0.1);
}

/* ============================================
   CUSTOMER SELECTOR
   ============================================ */
.customer-selector {
    position: relative;
    min-width: 280px;
}

.customer-label {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-bottom: 4px;
    letter-spacing: 0.05em;
}

.customer-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

.customer-icon {
    position: absolute;
    left: 12px;
    font-size: 1rem;
    pointer-events: none;
}

.customer-input {
    width: 100%;
    padding: 10px 36px 10px 40px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    font-size: 0.9rem;
    color: var(--color-text-primary);
    transition: border-color 0.15s;
}

.customer-input:focus {
    outline: none;
    border-color: var(--color-accent);
}

.customer-input::placeholder {
    color: var(--color-text-secondary);
}

.customer-clear {
    position: absolute;
    right: 10px;
    background: none;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 4px;
    font-size: 0.8rem;
}

.customer-clear:hover {
    color: var(--color-danger);
}

.customer-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: 4px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    max-height: 280px;
    overflow-y: auto;
    z-index: 100;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
}

.customer-option {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 14px;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    transition: background 0.1s;
    color: var(--color-text-primary);
}

.customer-option:hover,
.customer-option.highlighted {
    background: var(--color-bg-tertiary);
}

.customer-option.selected {
    background: rgba(59, 130, 246, 0.1);
}

.option-icon {
    font-size: 1.1rem;
}

.option-name {
    flex: 1;
    font-weight: 500;
}

.option-phone {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
}

.customer-no-results {
    padding: 16px;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.9rem;
}

/* ============================================
   QUICK AMOUNT BUTTONS
   ============================================ */
.quick-amounts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
    margin: var(--space-3) 0;
}

.quick-amount-btn {
    padding: 8px;
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text-primary);
    font-size: 0.85rem;
    font-family: var(--font-mono);
    cursor: pointer;
    transition: all 0.15s;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
}

.quick-amount-btn:hover {
    border-color: var(--color-accent);
    background: rgba(59, 130, 246, 0.1);
}

.quick-amount-btn.exact {
    border-color: var(--color-success);
}

.quick-amount-btn.exact:hover {
    background: rgba(16, 185, 129, 0.1);
}

.quick-label {
    font-size: 0.65rem;
    color: var(--color-success);
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

/* ============================================
   BARCODE INPUT
   ============================================ */
.barcode-toggle {
    padding: 8px 12px;
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.15s;
}

.barcode-toggle:hover {
    border-color: var(--color-accent);
    color: var(--color-text-primary);
}

.barcode-input-form {
    display: flex;
    gap: 4px;
}

.barcode-input {
    padding: 8px 12px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-accent);
    border-radius: 8px;
    font-size: 0.9rem;
    font-family: var(--font-mono);
    color: var(--color-text-primary);
    width: 160px;
}

.barcode-input:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
}

.barcode-submit {
    padding: 8px 12px;
    background: var(--color-accent);
    border: none;
    border-radius: 8px;
    color: white;
    cursor: pointer;
}

/* ============================================
   QUANTITY STEPPER
   ============================================ */
.qty-stepper {
    display: inline-flex;
    align-items: center;
    background: var(--color-bg-tertiary);
    border-radius: 25px;
    overflow: hidden;
    border: 1px solid var(--color-border);
}

.qty-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--color-text-primary);
    cursor: pointer;
    font-size: 1.1rem;
    font-weight: 500;
    transition: background 0.15s;
}

.qty-btn:hover:not(:disabled) {
    background: rgba(59, 130, 246, 0.2);
}

.qty-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

.qty-value {
    min-width: 36px;
    text-align: center;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.9rem;
}

/* Editable quantity input */
.qty-input {
    width: 48px;
    text-align: center;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.9rem;
    background: transparent;
    border: none;
    color: var(--color-text-primary);
    padding: 4px 2px;
    -moz-appearance: textfield;
}

.qty-input::-webkit-outer-spin-button,
.qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
}

.qty-input:focus {
    outline: none;
    background: rgba(59, 130, 246, 0.1);
    border-radius: 4px;
}

/* ============================================
   PAYMENT TOGGLE
   ============================================ */
.payment-toggle {
    display: flex;
    gap: 6px;
    margin-bottom: var(--space-3);
}

.payment-option {
    flex: 1;
    padding: 10px 6px;
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text-muted);
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 500;
    transition: all 0.2s;
    text-align: center;
}

.payment-option:hover {
    border-color: var(--color-accent);
}

.payment-option.active {
    background: rgba(59, 130, 246, 0.15);
    border-color: var(--color-accent);
    color: var(--color-accent);
}

/* ============================================
   CATEGORY TABS
   ============================================ */
.category-tabs {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding: 4px;
    margin-bottom: var(--space-3);
    -webkit-overflow-scrolling: touch;
}

.category-tabs::-webkit-scrollbar {
    display: none;
}

.category-tab {
    padding: 8px 16px;
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s;
}

.category-tab:hover {
    border-color: var(--color-accent);
    color: var(--color-text-primary);
}

.category-tab.active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
}

/* ============================================
   CART OVERLAY (Backdrop for drawer mode)
   ============================================ */
.cart-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
    z-index: 200;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
}

.cart-overlay.open {
    opacity: 1;
    pointer-events: auto;
}

/* Hide overlay on ultra-wide (cart is docked) */
@media (min-width: 1440px) {
    .cart-overlay {
        display: none;
    }
}

/* ============================================
   CART SIDEBAR - Slide-over Drawer
   Drawer mode (< 1440px) | Docked mode (≥ 1440px)
   ============================================ */
.cart-sidebar {
    /* Drawer dimensions */
    width: 460px;
    min-width: 420px;
    max-width: 520px;

    /* Full height panel */
    height: 100vh;
    max-height: 100vh;

    /* Styling */
    background: var(--color-bg-secondary);
    border-left: 1px solid var(--color-border);
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.3);

    /* Flex layout for 3 regions */
    display: flex;
    flex-direction: column;
    overflow: hidden;

    /* Drawer positioning - slides in from right */
    position: fixed;
    top: 0;
    right: 0;
    z-index: 201;

    /* Slide animation */
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.cart-sidebar.open {
    transform: translateX(0);
}

/* REGION 1: Fixed Header */
.cart-header {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    z-index: 2;
}

.cart-header h2 {
    margin: 0;
    font-size: 1.1rem;
}

.cart-header-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
}

.cart-count {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    padding: 4px 10px;
    background: var(--color-bg-tertiary);
    border-radius: 12px;
}

.cart-close-btn {
    background: none;
    border: none;
    color: var(--color-text-muted);
    font-size: 1.2rem;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 6px;
    transition: all 0.15s;
}

.cart-close-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-text-primary);
}

/* REGION 2: Scrollable Items List */
.cart-items {
    flex: 1 1 auto;
    min-height: 0;
    /* CRITICAL: enables flex child scrolling */
    overflow-y: auto;
    overflow-x: hidden;
    padding: var(--space-2);
    scroll-behavior: smooth;
}

/* Custom scrollbar for cart items */
.cart-items::-webkit-scrollbar {
    width: 6px;
}

.cart-items::-webkit-scrollbar-track {
    background: transparent;
}

.cart-items::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
}

.cart-items::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.25);
}

.cart-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--color-text-muted);
    text-align: center;
    padding: var(--space-6);
}

.cart-empty-icon {
    font-size: 3rem;
    margin-bottom: var(--space-3);
    opacity: 0.5;
}

.cart-empty-text {
    font-size: 1rem;
    font-weight: 500;
}

.cart-empty-hint {
    font-size: 0.85rem;
    margin-top: 4px;
    opacity: 0.7;
}

/* ============================================
   CART ITEM - With Selection States
   ============================================ */
.cart-item {
    position: relative;
    background: var(--color-bg-tertiary);
    border-radius: 10px;
    padding: var(--space-3);
    padding-left: calc(var(--space-3) + 4px);
    margin-bottom: var(--space-2);
    cursor: pointer;
    transition: all var(--pos-timing-transition) ease;
    border: 2px solid transparent;
}

/* Left accent bar - always present but hidden */
.cart-item-accent {
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 4px;
    border-radius: 0 4px 4px 0;
    background: transparent;
    transition: background var(--pos-timing-transition) ease;
}

/* Hover state */
.cart-item:hover {
    background: rgba(255, 255, 255, 0.03);
}

/* Selected state - clear highlight + accent bar */
.cart-item.selected {
    background: var(--pos-color-selected);
    border-color: var(--pos-accent-selected);
}

.cart-item.selected .cart-item-accent {
    background: var(--pos-accent-selected);
}

/* Flashing state - just added */
.cart-item.flashing {
    animation: cart-item-flash 500ms ease-out;
}

@keyframes cart-item-flash {
    0% {
        background: rgba(16, 185, 129, 0.3);
        transform: scale(1.02);
    }

    100% {
        background: var(--color-bg-tertiary);
        transform: scale(1);
    }
}

/* Focus state for keyboard nav */
.cart-item:focus {
    outline: none;
    border-color: var(--pos-accent-selected);
}

.cart-item:focus-visible {
    box-shadow: 0 0 0 2px var(--pos-accent-selected);
}

.cart-item-main {
    display: flex;
    align-items: center;
    gap: var(--space-3);
}

.cart-item-thumb {
    width: 44px;
    height: 44px;
    background: var(--color-bg-secondary);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    flex-shrink: 0;
}

.cart-item-info {
    flex: 1;
    min-width: 0;
}

.cart-item-name {
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
}

/* Meta info row: price × quantity */
.cart-item-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: 2px;
}

.cart-item-price {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
}

.cart-item-qty-label {
    font-size: 0.75rem;
    color: var(--pos-color-in-cart);
    font-family: var(--font-mono);
    font-weight: 600;
    background: rgba(34, 197, 94, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
}

/* Total positioned at right side */
.cart-item-total {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-accent);
    font-size: 0.95rem;
    margin-left: auto;
    white-space: nowrap;
}

/* Inline controls - hidden by default, visible on selection */
.cart-item-controls {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-2);
    margin-top: var(--space-2);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: all var(--pos-timing-transition) ease;
}

.cart-item-controls.visible {
    max-height: 60px;
    opacity: 1;
    padding-top: var(--space-3);
}

/* Remove button in inline controls */
.cart-item-remove-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid var(--pos-accent-danger);
    color: var(--pos-accent-danger);
    border-radius: var(--radius-md);
    padding: 6px 12px;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--pos-timing-transition) ease;
}

.cart-item-remove-btn:hover {
    background: var(--pos-accent-danger);
    color: white;
    transform: scale(1.02);
}

.cart-item-remove-btn:active {
    transform: scale(0.98);
}

/* Legacy remove button (small X) */
.cart-item-remove {
    background: none;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 4px;
    font-size: 0.8rem;
    opacity: 0.5;
    transition: all 0.15s;
}

.cart-item-remove:hover {
    opacity: 1;
    color: var(--color-danger);
}

/* Footer row with quantity stepper */
.cart-item-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
}

/* ============================================
   CART SUMMARY - REGION 3: Fixed Footer
   Always visible, never scrolls
   ============================================ */
.cart-summary {
    flex-shrink: 0;
    /* Never shrink */
    border-top: 1px solid var(--color-border);
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-secondary);
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.2);
    z-index: 2;
    max-height: 50vh;
    /* Prevent summary from taking too much space */
    overflow-y: auto;
}

/* Collapsible Adjust Section */
.adjust-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    margin-bottom: var(--space-2);
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    transition: all 0.15s ease;
}

.adjust-toggle:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-primary);
}

.adjust-toggle-icon {
    transition: transform 0.2s ease;
}

.adjust-toggle.open .adjust-toggle-icon {
    transform: rotate(180deg);
}

.adjust-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease;
}

.adjust-content.open {
    max-height: 200px;
}

.summary-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--space-2);
    font-size: 0.9rem;
}

.summary-row.discount {
    color: #f87171;
}

.summary-row.tax {
    color: #fbbf24;
}

.summary-row .mono {
    font-family: var(--font-mono);
}

.summary-input-row {
    margin-bottom: var(--space-3);
}

.summary-input-row label {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 4px;
}

.discount-input-group,
.tax-input-group {
    display: flex;
    gap: 4px;
}

.discount-input-group input,
.tax-input-group input {
    flex: 1;
    padding: 8px;
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text-primary);
}

.discount-input-group input:focus,
.tax-input-group input:focus {
    outline: none;
    border-color: var(--color-accent);
}

.discount-input-group select {
    padding: 8px;
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 0.85rem;
    color: var(--color-text-primary);
    cursor: pointer;
}

.input-suffix {
    display: flex;
    align-items: center;
    padding: 0 10px;
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 0.85rem;
    color: var(--color-text-muted);
}

.summary-total {
    display: flex;
    justify-content: space-between;
    font-size: 1.2rem;
    font-weight: 700;
    padding: var(--space-3) 0;
    margin: var(--space-2) 0;
    border-top: 2px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-accent);
}

.summary-total .mono {
    font-family: var(--font-mono);
}

/* Payment Section */
.payment-section {
    margin-top: var(--space-4);
}

.payment-section label {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 6px;
    margin-top: var(--space-3);
}

.payment-section label:first-child {
    margin-top: 0;
}

.paid-input {
    width: 100%;
    padding: 12px;
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 600;
    text-align: right;
    color: var(--color-text-primary);
}

.paid-input:focus {
    outline: none;
    border-color: var(--color-accent);
}

.balance-display {
    padding: var(--space-3);
    border-radius: 10px;
    text-align: center;
    margin-top: var(--space-3);
}

.balance-display.credit {
    background: rgba(251, 191, 36, 0.12);
    border: 1px solid rgba(251, 191, 36, 0.3);
}

.balance-display.change {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
}

.balance-label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 4px;
}

.balance-amount {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 700;
}

.balance-display.credit .balance-amount {
    color: #fbbf24;
}

.balance-display.change .balance-amount {
    color: #10b981;
}

/* Checkout Button */
.checkout-btn {
    width: 100%;
    padding: 16px;
    background: linear-gradient(135deg, #10b981, #059669);
    border: none;
    border-radius: 10px;
    color: white;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: var(--space-4);
}

.checkout-btn:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
}

.checkout-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
}

/* Keyboard Hints */
.cart-hints {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
}

.cart-hints span {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    padding: 3px 8px;
    background: var(--color-bg-tertiary);
    border-radius: 4px;
    font-family: var(--font-mono);
}

/* Hide hints on touch devices */
@media (pointer: coarse) {
    .cart-hints {
        display: none;
    }
}

/* ============================================
   RESPONSIVE
   ============================================ */

/* Tablet: Drawer slides from right, same as default */
@media (max-width: 1024px) {
    .cart-sidebar {
        width: 380px;
        min-width: 340px;
        max-width: 90vw;
    }
}

/* Mobile: Drawer slides up from bottom */
@media (max-width: 640px) {
    .cart-overlay.open {
        background: rgba(0, 0, 0, 0.6);
    }

    .cart-sidebar {
        width: 100%;
        min-width: 100%;
        max-width: 100%;
        height: 85vh;
        max-height: 85vh;
        top: auto;
        bottom: 0;
        left: 0;
        right: 0;
        border-left: none;
        border-top: 2px solid var(--color-border);
        border-radius: 16px 16px 0 0;
        transform: translateY(100%);
    }

    .cart-sidebar.open {
        transform: translateY(0);
    }

    .cart-items {
        max-height: 35vh;
    }

    .product-card {
        padding: var(--space-2);
    }

    .product-name {
        font-size: 0.8rem;
    }

    .product-price {
        font-size: 0.9rem;
    }

    .customer-selector {
        min-width: 100%;
    }

    .payment-option {
        padding: 8px 4px;
        font-size: 0.7rem;
    }

    /* Compact summary on mobile */
    .summary-input-row label {
        font-size: 0.7rem;
    }

    .paid-input {
        padding: 10px;
        font-size: 1rem;
    }

    .cart-hints {
        display: none;
    }
}

/* ============================================
   FLOATING CART BUTTON (FAB)
   ============================================ */
.cart-toggle-fab {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
        0 4px 12px rgba(59, 130, 246, 0.4),
        0 2px 4px rgba(0, 0, 0, 0.2);
    transition: all 0.2s ease;
    z-index: 1000;
}

.cart-toggle-fab:hover {
    transform: scale(1.08);
    box-shadow:
        0 6px 20px rgba(59, 130, 246, 0.5),
        0 4px 8px rgba(0, 0, 0, 0.25);
}

.cart-toggle-fab:active {
    transform: scale(0.95);
}

.cart-toggle-fab.hidden {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.8);
}

.cart-toggle-fab.has-items {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    box-shadow:
        0 4px 12px rgba(16, 185, 129, 0.4),
        0 2px 4px rgba(0, 0, 0, 0.2);
    animation: fab-pulse 2s infinite;
}

.cart-toggle-fab.has-items:hover {
    box-shadow:
        0 6px 20px rgba(16, 185, 129, 0.5),
        0 4px 8px rgba(0, 0, 0, 0.25);
}

@keyframes fab-pulse {

    0%,
    100% {
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4), 0 2px 4px rgba(0, 0, 0, 0.2);
    }

    50% {
        box-shadow: 0 4px 20px rgba(16, 185, 129, 0.6), 0 2px 4px rgba(0, 0, 0, 0.2);
    }
}

.fab-icon {
    font-size: 28px;
    line-height: 1;
}

.fab-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 24px;
    height: 24px;
    padding: 0 6px;
    background: #ef4444;
    color: white;
    font-size: 13px;
    font-weight: 700;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(239, 68, 68, 0.4);
}

