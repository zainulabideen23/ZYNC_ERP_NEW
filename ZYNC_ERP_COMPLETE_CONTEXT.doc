                                        <select className="form-input"
                                            value={companyInfo.financial_year_start ?? 7}
                                            onChange={e => setCompanyInfo(p => ({ ...p, financial_year_start: parseInt(e.target.value) }))}>
                                            {['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'].map((m, i) => (
