# Database Configuration
# DATABASE_URL=postgres://user:password@host:5432/database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zync_erp
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# Server Configuration
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
TRUST_PROXY=1

# Request/Rate Limiting
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
QUOTE_PUBLIC_RATE_LIMIT_MAX=60
QUOTE_PUBLIC_RESPOND_RATE_LIMIT_MAX=20
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb

# Logging
LOG_LEVEL=debug

# Database TLS (production)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=
# DB_SSL_CERT=
# DB_SSL_KEY=

# Multi-Tenancy
PLATFORM_ADMIN_SECRET=change-this-to-a-strong-secret
DEFAULT_TENANT_SLUG=default

# Platform Admin Panel
PLATFORM_JWT_SECRET=change-this-to-a-different-secret-from-jwt-secret
PLATFORM_JWT_EXPIRES_IN=8h
IMPERSONATION_JWT_EXPIRES_IN=2h

# SMTP / Email (for quotation delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=zu7167757@gmail.com
SMTP_PASS=xvkg tykn xrzi tomf
SMTP_FROM_NAME=Zync_erp
SMTP_FROM_EMAIL=zu7167757@gmail.com

# Public quotation response links
PUBLIC_APP_URL=http://localhost:5173
QUOTATION_TOKEN_EXPIRY_DAYS=30
