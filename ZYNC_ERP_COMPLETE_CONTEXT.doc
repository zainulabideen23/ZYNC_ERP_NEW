const fs = require('fs');
const path = require('path');

const ROOT_DIR = __dirname;
const OUTPUT_FILE = path.join(ROOT_DIR, 'ZYNC_ERP_COMPLETE_CONTEXT.doc');

const IGNORED_DIRS = [
    'node_modules',
    '.git',
    'dist',
    'build',
    'out',
    'coverage',
    '.vscode',
    '.idea',
    'logs',
    'tmp',
    'temp'
];

const IGNORED_EXTS = [
    '.png', '.jpg', '.jpeg', '.gif', '.svg', '.ico', '.pdf', '.zip', '.tar', '.gz',
    '.lock', '.log', '.sqlite', '.sqlite3', '.swp', '.swo', '.doc'
];

const IGNORED_FILES = [
    'package-lock.json',
    'currentfile.doc',
    'currentfile.backup.doc',
    'bundled_codebase.txt',
    'architecture_summary.json',
    'opencode.json'
];

function shouldIgnore(filePath, isDir) {
    const basename = path.basename(filePath);
    
    if (isDir) {
        return IGNORED_DIRS.includes(basename);
    } else {
        if (IGNORED_FILES.includes(basename)) return true;
        
        const ext = path.extname(basename).toLowerCase();
        if (IGNORED_EXTS.includes(ext)) return true;
        
        return false;
    }
}

function traverseAndCollect(dir, filesList = []) {
    const files = fs.readdirSync(dir);
    
    for (const file of files) {
        const fullPath = path.join(dir, file);
        let stat;
        try {
            stat = fs.statSync(fullPath);
        } catch (e) {
            continue;
        }
        
        if (stat.isDirectory()) {
            if (!shouldIgnore(fullPath, true)) {
                traverseAndCollect(fullPath, filesList);
            }
        } else {
            if (!shouldIgnore(fullPath, false)) {
                filesList.push(fullPath);
            }
        }
    }
    return filesList;
}

function generateDoc() {
    console.log('Scanning directory for files...');
    const allFiles = traverseAndCollect(ROOT_DIR);
    console.log(`Found ${allFiles.length} files. Generating document...`);
    
    const writeStream = fs.createWriteStream(OUTPUT_FILE);
    
    for (const file of allFiles) {
        const relativePath = path.relative(ROOT_DIR, file).replace(/\\/g, '/');
        
        try {
            const content = fs.readFileSync(file, 'utf8');
            
            // Skip binary files that slip through or files that are too huge
            if (content.includes('\x00')) continue;
            
            writeStream.write('\n================================================================================\n');
            writeStream.write(`File: ${relativePath}\n`);
            writeStream.write('================================================================================\n\n');
            writeStream.write(content);
            writeStream.write('\n');
            
        } catch (e) {
            console.error(`Failed to read ${relativePath}:`, e.message);
        }
    }
    
    writeStream.end();
    console.log(`Successfully generated ${OUTPUT_FILE}`);
}

generateDoc();


