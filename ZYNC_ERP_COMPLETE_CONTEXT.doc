import React from 'react'
import { Loader2 } from 'lucide-react'

export default function Button({ 
  variant = 'primary', 
  size = 'default', 
  loading = false, 
  icon: Icon, 
  children, 
  disabled, 
  iconOnly = false,
  className = '',
  ...props 
}) {
  let baseClass = 'inline-flex items-center justify-center font-medium transition-colors focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed '

  if (iconOnly) {
    baseClass += 'w-[28px] h-[28px] rounded-[var(--r4)] border-[0.5px] border-[var(--border)] text-[var(--muted)] hover:bg-[var(--surface-2)] hover:text-[var(--text)] bg-transparent '
  } else {
    baseClass += size === 'sm' 
      ? 'h-[28px] text-[12px] rounded-[var(--r4)] px-[10px] '
      : 'h-[34px] text-[13px] rounded-[var(--r6)] px-[14px] '

    switch (variant) {
      case 'primary':
        baseClass += 'bg-[var(--blue)] text-white border-none hover:opacity-90 '
        break
      case 'secondary':
        baseClass += 'bg-transparent text-[var(--text)] border-[0.5px] border-[var(--border-2)] hover:bg-[var(--surface-2)] '
        break
      case 'danger':
        baseClass += 'bg-[var(--red-dim)] text-[var(--red)] border-[0.5px] border-[rgba(239,68,68,0.25)] hover:bg-[rgba(239,68,68,0.2)] '
        break
      case 'ghost':
        baseClass += 'bg-transparent text-[var(--muted)] border-none hover:bg-[var(--surface-2)] hover:text-[var(--text)] '
        break
    }
  }

  return (
    <button 
      className={`${baseClass} ${className}`}
      disabled={disabled || loading}
      {...props}
    >
      {loading ? (
        <Loader2 size={14} className="animate-spin mr-2" />
      ) : Icon ? (
        <Icon size={iconOnly ? 14 : 16} className={children ? "mr-2" : ""} />
      ) : null}
      {children}
    </button>
  )
}


