import React from 'react'

export default function StatCard({ label, value, sublabel, accentColor = 'var(--blue)', icon: Icon, className = '' }) {
  const cardStyle = {
    backgroundColor: 'var(--surface)',
    border: '0.5px solid var(--border)',
    borderRadius: 'var(--r8)',
    padding: '14px 16px',
    position: 'relative',
    display: 'flex',
    flexDirection: 'column',
    gap: '4px'
  }

  const leftBarStyle = {
    position: 'absolute',
    left: 0,
    top: 0,
    bottom: 0,
    width: '3px',
    backgroundColor: accentColor,
    borderRadius: '3px 0 0 3px'
  }

  const headerStyle = {
    display: 'flex',
    justifyContent: 'space-between',
    alignItems: 'flex-start'
  }

  const labelStyle = {
    fontSize: '10px',
    textTransform: 'uppercase',
    color: 'var(--muted)',
    letterSpacing: '0.05em',
    fontWeight: 600
  }

  const valueStyle = {
    fontSize: '20px',
    fontWeight: 600,
    color: 'var(--text)',
    marginTop: '4px'
  }

  const sublabelStyle = {
    fontSize: '11px',
    color: 'var(--muted)'
  }

  return (
    <div style={cardStyle} className={className}>
      <div style={leftBarStyle} />
      <div style={headerStyle}>
        <div style={labelStyle}>{label}</div>
        {Icon && <Icon size={16} color={accentColor} />}
      </div>
      <div style={valueStyle}>{value}</div>
      {sublabel && (
        <div style={sublabelStyle} className="mt-1">
          {sublabel}
        </div>
      )}
    </div>
  )
}


