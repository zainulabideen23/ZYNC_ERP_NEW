                                    {companyInfo.strn_number && !/^\d{13}$/.test(companyInfo.strn_number) && (
                                        <span style={{ fontSize: '0.75rem', color: '#f59e0b' }}>⚠ STRN should be exactly 13 digits</span>
                                    )}
                                    {companyInfo.strn_number && /^\d{13}$/.test(companyInfo.strn_number) && (
                                        <span style={{ fontSize: '0.75rem', color: '#10b981' }}>✓ Valid STRN format</span>
                                    )}
