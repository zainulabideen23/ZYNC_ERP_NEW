import { useState, useEffect } from 'react'
import { toast } from 'react-hot-toast'
import { unitsAPI } from '../services/api'

function Units() {
    const [units, setUnits] = useState([])
    const [loading, setLoading] = useState(true)
    const [showAll, setShowAll] = useState(false)
    const [editing, setEditing] = useState(null)
    const [form, setForm] = useState({ name: '', abbreviation: '', description: '' })
    const [saving, setSaving] = useState(false)
    const [showCreate, setShowCreate] = useState(false)

    useEffect(() => { loadUnits() }, [showAll])

    const loadUnits = async () => {
        try {
            setLoading(true)
            const res = await unitsAPI.list(showAll ? { all: true } : {})
            setUnits(res.data || [])
        } catch (error) {
            toast.error('Failed to load units')
        } finally {
            setLoading(false)
        }
    }

    const handleCreate = async () => {
        if (!form.name.trim() || !form.abbreviation.trim()) {
            toast.error('Name and abbreviation are required')
            return
        }
        try {
            setSaving(true)
            await unitsAPI.create({ name: form.name.trim(), abbreviation: form.abbreviation.trim(), description: form.description.trim() })
            toast.success('Unit created')
            setForm({ name: '', abbreviation: '', description: '' })
            setShowCreate(false)
            loadUnits()
        } catch (err) {
            toast.error(err.message || 'Failed to create unit')
        } finally {
            setSaving(false)
        }
    }

    const handleEdit = (unit) => {
        setEditing(unit.id)
        setForm({ name: unit.name, abbreviation: unit.abbreviation, description: unit.description || '' })
    }

    const handleSaveEdit = async () => {
        if (!form.name.trim() || !form.abbreviation.trim()) {
            toast.error('Name and abbreviation are required')
            return
        }
        try {
            setSaving(true)
            await unitsAPI.update(editing, {
                name: form.name.trim(),
                abbreviation: form.abbreviation.trim(),
                description: form.description.trim()
            })
            toast.success('Unit updated')
            setEditing(null)
            setForm({ name: '', abbreviation: '', description: '' })
            loadUnits()
        } catch (err) {
            toast.error(err.message || 'Failed to update unit')
        } finally {
            setSaving(false)
        }
    }

    const handleToggleActive = async (unit) => {
        try {
            await unitsAPI.update(unit.id, { is_active: !unit.is_active })
            toast.success(unit.is_active ? 'Unit deactivated' : 'Unit activated')
            loadUnits()
        } catch (err) {
            toast.error(err.message || 'Failed to update unit')
        }
    }

    const handleDelete = async (unit) => {
        if (!window.confirm(`Delete unit "${unit.name}"? This cannot be undone.`)) return
        try {
            await unitsAPI.delete(unit.id)
            toast.success('Unit deleted')
            loadUnits()
        } catch (err) {
            toast.error(err.message || 'Cannot delete: unit is in use')
        }
    }

    const cancelEdit = () => {
        setEditing(null)
        setForm({ name: '', abbreviation: '', description: '' })
    }

    return (
        <div className="page-container dark-theme" style={{ background: '#0f172a', minHeight: '100vh', color: '#e2e8f0' }}>
            <div className="page-header">
                <h1 className="page-title">📏 Units Management</h1>
                <div style={{ display: 'flex', gap: '0.75rem', alignItems: 'center' }}>
                    <label style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', fontSize: '0.85rem', color: '#94a3b8', cursor: 'pointer' }}>
                        <input type="checkbox" checked={showAll} onChange={e => setShowAll(e.target.checked)} />
                        Show inactive
                    </label>
                    <button className="btn btn-primary" onClick={() => { setShowCreate(true); setEditing(null); setForm({ name: '', abbreviation: '', description: '' }) }}>
                        + Add Unit
                    </button>
                </div>
            </div>

            {showCreate && !editing && (
                <div className="card" style={{ background: '#1e293b', border: '1px solid #334155', borderRadius: 12, padding: '1.5rem', marginBottom: '1.5rem' }}>
                    <h3 style={{ margin: '0 0 1rem', fontSize: '1rem', color: '#3b82f6' }}>Create New Unit</h3>
                    <div style={{ display: 'flex', gap: '0.75rem', alignItems: 'flex-end', flexWrap: 'wrap' }}>
                        <div style={{ display: 'flex', flexDirection: 'column', gap: '0.35rem', flex: 1, minWidth: 150 }}>
                            <label style={{ fontSize: '0.8rem', color: '#94a3b8', fontWeight: 600 }}>Name *</label>
                            <input className="form-input" value={form.name} onChange={e => setForm(p => ({ ...p, name: e.target.value }))} placeholder="e.g. Kilogram" />
                        </div>
                        <div style={{ display: 'flex', flexDirection: 'column', gap: '0.35rem', width: 120 }}>
                            <label style={{ fontSize: '0.8rem', color: '#94a3b8', fontWeight: 600 }}>Abbreviation *</label>
                            <input className="form-input" value={form.abbreviation} onChange={e => setForm(p => ({ ...p, abbreviation: e.target.value }))} placeholder="e.g. kg" maxLength={10} />
                        </div>
                        <div style={{ display: 'flex', flexDirection: 'column', gap: '0.35rem', flex: 1, minWidth: 150 }}>
                            <label style={{ fontSize: '0.8rem', color: '#94a3b8', fontWeight: 600 }}>Description</label>
                            <input className="form-input" value={form.description} onChange={e => setForm(p => ({ ...p, description: e.target.value }))} placeholder="Optional" />
                        </div>
                        <button className="btn btn-primary" onClick={handleCreate} disabled={saving} style={{ height: 38 }}>
                            {saving ? 'Creating...' : 'Create'}
                        </button>
                        <button className="btn btn-ghost" onClick={() => setShowCreate(false)} style={{ height: 38 }}>Cancel</button>
                    </div>
                </div>
            )}

            <div className="card" style={{ background: '#1e293b', border: '1px solid #334155', borderRadius: 12, overflow: 'hidden' }}>
                {loading ? (
                    <div style={{ padding: '2rem', textAlign: 'center', color: '#94a3b8' }}>Loading...</div>
                ) : units.length === 0 ? (
                    <div style={{ padding: '2rem', textAlign: 'center', color: '#94a3b8' }}>No units found. Add one above.</div>
                ) : (
                    <table className="table" style={{ width: '100%' }}>
                        <thead>
                            <tr>
                                <th style={thStyle}>Name</th>
                                <th style={thStyle}>Abbreviation</th>
                                <th style={thStyle}>Description</th>
                                <th style={thStyle}>Status</th>
                                <th style={{ ...thStyle, textAlign: 'right' }}>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {units.map(unit => (
                                <tr key={unit.id} style={{ borderBottom: '1px solid #334155' }}>
                                    {editing === unit.id ? (
                                        <>
                                            <td style={tdStyle}>
                                                <input className="form-input" value={form.name}
                                                    onChange={e => setForm(p => ({ ...p, name: e.target.value }))}
                                                    style={{ padding: '6px 10px', fontSize: '0.85rem' }} />
                                            </td>
                                            <td style={tdStyle}>
                                                <input className="form-input" value={form.abbreviation}
                                                    onChange={e => setForm(p => ({ ...p, abbreviation: e.target.value }))}
                                                    maxLength={10}
                                                    style={{ padding: '6px 10px', fontSize: '0.85rem', width: 80 }} />
                                            </td>
                                            <td style={tdStyle}>
                                                <input className="form-input" value={form.description}
                                                    onChange={e => setForm(p => ({ ...p, description: e.target.value }))}
                                                    style={{ padding: '6px 10px', fontSize: '0.85rem' }} />
                                            </td>
                                            <td style={tdStyle}>—</td>
                                            <td style={{ ...tdStyle, textAlign: 'right' }}>
                                                <div style={{ display: 'flex', gap: '0.5rem', justifyContent: 'flex-end' }}>
                                                    <button onClick={handleSaveEdit} disabled={saving}
                                                        style={{ ...btnSmall, background: '#10b981', color: '#fff' }}>
                                                        {saving ? '...' : 'Save'}
                                                    </button>
                                                    <button onClick={cancelEdit} style={{ ...btnSmall, background: '#475569', color: '#e2e8f0' }}>Cancel</button>
                                                </div>
                                            </td>
                                        </>
                                    ) : (
                                        <>
                                            <td style={{ ...tdStyle, fontWeight: 600 }}>{unit.name}</td>
                                            <td style={tdStyle}>
                                                <span style={{ fontFamily: 'monospace', background: '#334155', padding: '2px 8px', borderRadius: 4, fontSize: '0.85rem' }}>
                                                    {unit.abbreviation}
                                                </span>
                                            </td>
                                            <td style={{ ...tdStyle, color: '#94a3b8' }}>{unit.description || '—'}</td>
                                            <td style={tdStyle}>
                                                <span style={{
                                                    fontSize: '0.75rem', fontWeight: 600, padding: '3px 10px', borderRadius: 20,
                                                    background: unit.is_active ? 'rgba(16,185,129,0.15)' : 'rgba(239,68,68,0.15)',
                                                    color: unit.is_active ? '#10b981' : '#ef4444'
                                                }}>
                                                    {unit.is_active ? 'Active' : 'Inactive'}
                                                </span>
                                            </td>
                                            <td style={{ ...tdStyle, textAlign: 'right' }}>
                                                <div style={{ display: 'flex', gap: '0.5rem', justifyContent: 'flex-end' }}>
                                                    <button onClick={() => handleEdit(unit)} style={{ ...btnSmall, background: 'transparent', border: '1px solid #334155', color: '#3b82f6' }}>Edit</button>
                                                    <button onClick={() => handleToggleActive(unit)} style={{ ...btnSmall, background: 'transparent', border: '1px solid #334155', color: unit.is_active ? '#f59e0b' : '#10b981' }}>
                                                        {unit.is_active ? 'Deactivate' : 'Activate'}
                                                    </button>
                                                    <button onClick={() => handleDelete(unit)} style={{ ...btnSmall, background: 'transparent', border: '1px solid #334155', color: '#ef4444' }}>Delete</button>
                                                </div>
                                            </td>
                                        </>
                                    )}
                                </tr>
                            ))}
                        </tbody>
                    </table>
                )}
            </div>
        </div>
    )
}

const thStyle = { background: '#334155', color: '#94a3b8', fontWeight: 600, padding: '14px 16px', fontSize: '0.85rem', textAlign: 'left', borderBottom: 'none' }
const tdStyle = { padding: '12px 16px', color: '#e2e8f0', fontSize: '0.9rem' }
const btnSmall = { padding: '5px 12px', borderRadius: 6, cursor: 'pointer', fontSize: '0.8rem', fontWeight: 500, border: 'none', transition: 'all 0.15s' }

export default Units


