@import "tailwindcss";

/* ============================================
   ZYNC ERP — Global Styles
   Clean, modern SaaS UI — references tokens.css
   ============================================ */

/* ─── Reset ─── */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  font-family: var(--font-sans);
  background-color: var(--color-bg);
  color: var(--color-text);
  line-height: 1.5;
  min-height: 100vh;
  transition: background-color 0.2s ease, color 0.2s ease;
}

/* ─── Focus & Accessibility ─── */
*:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
}

/* ─── Scrollbar ─── */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: var(--color-panel-3);
  border-radius: 3px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--color-muted);
}

/* ─── Typography ─── */
h1, h2, h3, h4, h5, h6 {
  font-weight: 600;
  line-height: 1.2;
  color: var(--color-text);
}

h1 { font-size: 1.75rem; font-weight: 700; }
h2 { font-size: 1.375rem; font-weight: 600; }
h3 { font-size: 1.125rem; font-weight: 600; }
h4 { font-size: 1rem; font-weight: 600; }

/* ─── Links ─── */
a {
  color: var(--color-accent);
  text-decoration: none;
  transition: color 0.15s ease;
}

a:hover {
  color: var(--color-accent-hover);
  opacity: 1;
}

/* ─── Buttons ─── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: 10px 16px;
  min-height: 40px;
  font-size: 0.875rem;
  font-weight: 500;
  border-radius: var(--radius-md);
  border: none;
  cursor: pointer;
  transition: all 0.15s ease;
  font-family: inherit;
}

.btn:active {
  transform: scale(0.98);
}

.btn-primary {
  background: var(--color-accent);
  color: white;
  box-shadow: 0 1px 2px rgba(37, 99, 235, 0.2);
}

.btn-primary:hover {
  background: var(--color-accent-hover);
  box-shadow: 0 2px 4px rgba(37, 99, 235, 0.3);
}

.btn-secondary {
  background: var(--color-panel);
  border: 1px solid var(--border-surface);
  color: var(--color-text);
}

.btn-secondary:hover {
  background: var(--color-panel-2);
  border-color: var(--color-muted);
}

.btn-success {
  background: var(--color-success);
  color: white;
}

.btn-success:hover {
  background: #059669;
}

.btn-danger {
  background: var(--color-danger);
  color: white;
}

.btn-danger:hover {
  background: #DC2626;
}

.btn-ghost {
  background: transparent;
  border: 1px solid var(--border-surface);
  color: var(--color-muted);
}

.btn-ghost:hover {
  background: var(--color-panel-2);
  color: var(--color-text);
  border-color: var(--color-muted);
}

.btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.btn-sm {
  padding: 6px 12px;
  min-height: 34px;
  font-size: 0.8125rem;
}

.btn-warning {
  background: var(--color-warning);
  color: white;
}

/* ─── Form Elements ─── */
.form-group {
  margin-bottom: var(--space-3);
}

.form-label {
  display: block;
  margin-bottom: 6px;
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--color-muted);
}

.form-input,
.form-select,
.form-textarea {
  width: 100%;
  padding: 10px 12px;
  background: var(--color-panel);
  border: 1px solid var(--border-surface);
  border-radius: var(--radius-md);
  color: var(--color-text);
  font-size: 0.875rem;
  font-family: inherit;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.form-input:focus,
.form-select:focus,
.form-textarea:focus {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  outline: none;
}

.form-input::placeholder {
  color: var(--color-hint);
}

.form-input:disabled,
.form-select:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  background: var(--color-panel-2);
}

.mb-0 {
  margin-bottom: 0;
}

/* ─── Cards ─── */
.card {
  background: var(--color-panel);
  border: 1px solid var(--border-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  box-shadow: var(--elevation-1);
  transition: box-shadow 0.2s ease;
}

.card:hover {
  box-shadow: var(--elevation-2);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-3);
}

.card-title {
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-text);
}

/* ─── Tables ─── */
.table-container {
  overflow-x: auto;
}

.table {
  width: 100%;
  border-collapse: collapse;
}

.table th,
.table td {
  padding: var(--space-2) var(--space-3);
  text-align: left;
  border-bottom: 1px solid var(--border-surface);
  min-height: 48px;
  vertical-align: middle;
}

.table th {
  background: var(--color-panel-2);
  font-weight: 600;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-muted);
  position: sticky;
  top: 0;
  z-index: 1;
}

.table tbody tr {
  transition: background 0.1s ease;
}

.table tbody tr:hover {
  background: var(--color-panel-2);
}

/* Table checkbox column */
.table-checkbox {
  width: 44px;
  text-align: center;
}

.table-checkbox input[type="checkbox"] {
  width: 16px;
  height: 16px;
  cursor: pointer;
  accent-color: var(--color-accent);
}

/* Responsive table → card layout */
@media (max-width: 768px) {
  .table-container.responsive-table table,
  .table-container.responsive-table thead,
  .table-container.responsive-table tbody,
  .table-container.responsive-table th,
  .table-container.responsive-table td,
  .table-container.responsive-table tr {
    display: block;
  }

  .table-container.responsive-table thead {
    display: none;
  }

  .table-container.responsive-table tbody tr {
    background: var(--color-panel);
    border: 1px solid var(--border-surface);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-2);
    padding: var(--space-2);
  }

  .table-container.responsive-table td {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-1) var(--space-2);
    border-bottom: 1px solid var(--border-light);
    min-height: auto;
  }

  .table-container.responsive-table td:last-child {
    border-bottom: none;
  }

  .table-container.responsive-table td::before {
    content: attr(data-label);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-right: var(--space-2);
  }
}

/* ─── Badges ─── */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 3px 8px;
  font-size: 0.75rem;
  font-weight: 500;
  border-radius: var(--radius-full);
}

.badge-success {
  background: var(--green-dim);
  color: var(--color-success);
}

.badge-warning {
  background: var(--amber-dim);
  color: var(--color-warning);
}

.badge-danger {
  background: var(--red-dim);
  color: var(--color-danger);
}

.badge-accent,
.badge-primary {
  background: var(--blue-dim);
  color: var(--color-accent);
}

.badge-secondary {
  background: var(--color-panel-2);
  color: var(--color-muted);
}

.badge-ghost {
  background: transparent;
  border: 1px solid currentColor;
}

.badge-ghost-success {
  background: transparent;
  border: 1px solid var(--color-success);
  color: var(--color-success);
}

.badge-ghost-danger {
  background: transparent;
  border: 1px solid var(--color-danger);
  color: var(--color-danger);
}

.badge-ghost-warning {
  background: transparent;
  border: 1px solid var(--color-warning);
  color: var(--color-warning);
}

/* ─── KPI / Stat Cards ─── */
.stat-card {
  background: var(--color-panel);
  border: 1px solid var(--border-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  box-shadow: var(--elevation-1);
  border-left: 4px solid var(--color-accent);
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}

.stat-card:hover {
  box-shadow: var(--elevation-2);
  transform: translateY(-1px);
}

.stat-card.green { border-left-color: var(--color-success); }
.stat-card.orange { border-left-color: var(--color-warning); }
.stat-card.purple { border-left-color: #8B5CF6; }
.stat-card.red,
.stat-card.danger { border-left-color: var(--color-danger); }

.stat-label {
  font-size: 0.8125rem;
  color: var(--color-muted);
  margin-bottom: var(--space-1);
  font-weight: 500;
}

.stat-value {
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--color-text);
}

.stat-change {
  font-size: 0.8125rem;
  margin-top: var(--space-2);
}

.stat-change.positive { color: var(--color-success); }
.stat-change.negative { color: var(--color-danger); }

/* ─── Page Layout ─── */
.page-container {
  padding: var(--space-4);
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-4);
}

.page-title {
  font-size: 1.375rem;
  font-weight: 700;
  color: var(--color-text);
}

/* ─── Grid ─── */
.grid {
  display: grid;
  gap: var(--space-4);
}

.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }

@media (max-width: 1024px) {
  .grid-4 { grid-template-columns: repeat(2, 1fr); }
  .grid-3 { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 640px) {
  .grid-4,
  .grid-3,
  .grid-2 { grid-template-columns: 1fr; }
}

/* ─── Flex Utilities ─── */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.items-center { align-items: center; }
.justify-between { justify-content: space-between; }
.gap-2 { gap: var(--space-2); }
.gap-4 { gap: var(--space-3); }

/* ─── Text Utilities ─── */
.text-sm { font-size: 0.875rem; }
.text-xs { font-size: 0.75rem; }
.text-muted { color: var(--color-muted); }
.text-right { text-align: right; }
.text-center { text-align: center; }
.font-mono { font-family: var(--font-mono); }
.cursor-pointer { cursor: pointer; }
.text-success { color: var(--color-success); }
.text-danger { color: var(--color-danger); }
.text-warning { color: var(--color-warning); }
.text-primary { color: var(--color-accent); }
.text-accent { color: var(--color-accent); }
.p-4 { padding: var(--space-3); }
.p-6 { padding: var(--space-4); }

/* ─── Quantity Stepper ─── */
.quantity-stepper {
  display: inline-flex;
  align-items: center;
  background: var(--color-panel-2);
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 1px solid var(--border-surface);
}

.quantity-stepper button {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  color: var(--color-text);
  cursor: pointer;
  transition: background 0.15s;
  min-height: 40px;
}

.quantity-stepper button:hover {
  background: var(--color-accent);
  color: white;
}

.quantity-stepper .value {
  min-width: 32px;
  text-align: center;
  font-family: var(--font-mono);
  font-weight: 600;
}

/* ─── Segmented Toggle ─── */
.segmented-toggle {
  display: inline-flex;
  background: var(--color-panel-2);
  border-radius: var(--radius-md);
  padding: 3px;
  gap: 2px;
  border: 1px solid var(--border-surface);
}

.segmented-toggle button {
  padding: var(--space-2) var(--space-3);
  background: transparent;
  border: none;
  border-radius: var(--radius-sm);
  color: var(--color-muted);
  font-size: 0.85rem;
  cursor: pointer;
  transition: all 0.15s;
  min-height: 36px;
  font-weight: 500;
}

.segmented-toggle button.active {
  background: var(--color-accent);
  color: white;
  box-shadow: var(--elevation-1);
}

.segmented-toggle button:hover:not(.active) {
  color: var(--color-text);
  background: var(--color-panel);
}

/* ─── Modal Shared Styles ─── */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

[data-theme="dark"] .modal-overlay {
  background: rgba(0, 0, 0, 0.6);
}

.modal,
.modal-content {
  background: var(--color-panel);
  border: 1px solid var(--border-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  width: 100%;
  max-width: 600px;
  box-shadow: var(--elevation-3);
  animation: modalSlide 0.2s ease-out;
}

@keyframes modalSlide {
  from {
    transform: translateY(20px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-4);
}

.modal-header h3 {
  margin: 0;
}

.close-btn {
  background: transparent;
  border: none;
  color: var(--color-muted);
  font-size: 1.5rem;
  cursor: pointer;
  line-height: 1;
  min-height: 40px;
  min-width: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  transition: all 0.15s ease;
}

.close-btn:hover {
  color: var(--color-text);
  background: var(--color-panel-2);
}

.modal-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-3);
  margin-top: var(--space-4);
  padding-top: var(--space-3);
  border-top: 1px solid var(--border-surface);
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
}

.full-width {
  grid-column: span 2;
}

.modal-body {
  max-height: 70vh;
  overflow-y: auto;
  padding-right: var(--space-2);
}

/* ─── Settings page specific ─── */
.settings-tabs {
  display: flex;
  gap: var(--space-2);
  border-bottom: 2px solid var(--border-surface);
}

.settings-tab {
  padding: 12px 20px;
  border: none;
  background: none;
  cursor: pointer;
  border-bottom: 3px solid transparent;
  color: var(--color-muted);
  font-weight: 500;
  font-size: 0.875rem;
  font-family: inherit;
  transition: all 0.15s ease;
  min-height: 44px;
}

.settings-tab:hover {
  color: var(--color-text);
}

.settings-tab--active {
  border-bottom-color: var(--color-accent);
  color: var(--color-accent);
  font-weight: 600;
}

/* Balance Rows */
.balance-row {
  padding: var(--space-2) var(--space-3);
  border: 1px solid var(--border-surface);
  border-radius: var(--radius-md);
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: background 0.1s;
}

.balance-row:hover {
  background: var(--color-panel-2);
}

.balance-name {
  font-weight: 600;
  margin-bottom: 4px;
  color: var(--color-text);
}

.balance-detail {
  font-size: 0.85rem;
  color: var(--color-muted);
}

.balance-value {
  font-size: 1rem;
  font-weight: 700;
  color: var(--color-accent);
  min-width: 80px;
  text-align: right;
}

.balance-edit-btn {
  padding: 6px 12px;
  background: var(--blue-dim);
  color: var(--color-accent);
  border: none;
  border-radius: var(--radius-md);
  cursor: pointer;
  font-size: 0.85rem;
  font-family: inherit;
  transition: all 0.15s;
  min-height: 36px;
}

.balance-edit-btn:hover {
  background: rgba(37, 99, 235, 0.15);
}

.balance-edit-btn.supplier {
  background: var(--red-dim);
  color: var(--color-danger);
}

.balance-edit-btn.supplier:hover {
  background: rgba(239, 68, 68, 0.15);
}

/* Backup Items */
.backup-item {
  padding: var(--space-2);
  background: var(--color-panel-2);
  border-radius: var(--radius-md);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.9rem;
  border: 1px solid var(--border-surface);
}

.backup-item-name {
  font-weight: 600;
  color: var(--color-text);
}

.backup-item-meta {
  font-size: 0.85rem;
  color: var(--color-muted);
}

.info-heading {
  margin-bottom: var(--space-2);
  font-weight: 700;
  color: var(--color-accent);
}

.info-list {
  margin-left: 20px;
  font-size: 0.9rem;
  line-height: 1.6;
  color: var(--color-muted);
}

.empty-state {
  padding: var(--space-3);
  text-align: center;
  color: var(--color-muted);
  font-size: 0.9rem;
}

/* ─── Report tabs ─── */
.report-tab {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  padding: 10px 16px;
  min-height: 40px;
  border: 1px solid var(--border-surface);
  background: var(--color-panel);
  color: var(--color-muted);
  border-radius: var(--radius-md);
  font-size: 0.875rem;
  font-weight: 500;
  font-family: inherit;
  cursor: pointer;
  transition: all 0.15s ease;
}

.report-tab:hover {
  background: var(--color-panel-2);
  color: var(--color-text);
}

.report-tab--active {
  background: var(--color-accent);
  color: white;
  border-color: var(--color-accent);
}

/* ─── Adjustment / Stock badges ─── */
.adj-badge {
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  border-radius: var(--radius-full);
  font-size: 0.8rem;
  font-weight: 600;
}

.adj-badge.add {
  background: var(--green-dim);
  color: var(--color-success);
}

.adj-badge.remove {
  background: var(--red-dim);
  color: var(--color-danger);
}

/* ─── Summary stat cards ─── */
.summary-stat {
  background: var(--color-panel);
  border-radius: var(--radius-md);
  padding: var(--space-2) var(--space-3);
  border: 1px solid var(--border-surface);
}

.summary-stat-label {
  font-size: 0.8rem;
  color: var(--color-muted);
  margin-bottom: 4px;
}

.summary-stat-value {
  font-size: 1.5rem;
  font-weight: 700;
}

.summary-stat-value.success { color: var(--color-success); }
.summary-stat-value.danger { color: var(--color-danger); }
.summary-stat-value.accent { color: var(--color-accent); }

/* ─── Color utility classes ─── */
.bg-accent { background: var(--color-accent); }
.bg-success { background: var(--color-success); }
.bg-danger { background: var(--color-danger); }
.bg-warning { background: var(--color-warning); }

