/* ============================================
   ZYNC ERP — Layout & Sidebar
   Clean, modern sidebar navigation
   ============================================ */

/* ─── Layout Shell ─── */
.layout {
  display: flex;
  min-height: 100vh;
  background: var(--color-bg);
}

/* ─── Sidebar ─── */
.sidebar {
  width: 252px;
  background: var(--color-panel);
  border-right: 1px solid var(--border-surface);
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  z-index: 100;
  transition: background 0.2s ease;
}

/* Sidebar Header */
.sidebar-header {
  padding: 20px 20px 16px;
  border-bottom: 1px solid var(--border-surface);
}

.logo {
  font-size: 1.375rem;
  font-weight: 800;
  color: var(--color-accent);
  letter-spacing: -0.02em;
  background: none;
  -webkit-text-fill-color: unset;
}

.logo-sub {
  font-size: 0.6875rem;
  color: var(--color-hint);
  display: block;
  margin-top: 2px;
  font-weight: 500;
  letter-spacing: 0.02em;
}

/* ─── Navigation ─── */
.sidebar-nav {
  flex: 1;
  padding: 12px 12px;
  overflow-y: auto;
}

.sidebar-nav::-webkit-scrollbar { width: 4px; }
.sidebar-nav::-webkit-scrollbar-track { background: transparent; }
.sidebar-nav::-webkit-scrollbar-thumb { background: var(--border-surface); border-radius: 4px; }

/* Section Labels */
.nav-section {
  margin-bottom: 4px;
}

.nav-section-label {
  font-size: 0.625rem;
  font-weight: 600;
  color: var(--color-hint);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 12px 12px 6px;
  margin-top: 4px;
}

.nav-section:first-child .nav-section-label {
  margin-top: 0;
  padding-top: 4px;
}

/* Nav Items */
.nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 12px;
  border-radius: var(--radius-md);
  color: var(--color-muted);
  transition: all 0.15s ease;
  margin-bottom: 2px;
  border-left: 3px solid transparent;
  text-decoration: none;
  position: relative;
  font-size: 0.875rem;
}

.nav-item:hover {
  background: var(--color-panel-2);
  color: var(--color-text);
  opacity: 1;
}

.nav-item.active {
  background: var(--color-accent-light);
  border-left-color: var(--color-accent);
  color: var(--color-accent);
  font-weight: 500;
}

.nav-item.active .nav-icon {
  color: var(--color-accent);
}

.nav-icon {
  font-size: 1rem;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.nav-label {
  font-size: 0.8125rem;
  font-weight: 500;
}

/* ─── New Sale Button ─── */
.nav-new-sale-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin: 8px 12px 4px;
  padding: 8px 14px;
  background: var(--color-accent);
  color: white;
  border: none;
  border-radius: var(--radius-md);
  font-size: 0.8125rem;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  transition: all 0.15s ease;
  box-shadow: 0 1px 3px rgba(37, 99, 235, 0.25);
}

.nav-new-sale-btn:hover {
  background: var(--color-accent-hover);
  box-shadow: 0 2px 6px rgba(37, 99, 235, 0.35);
  transform: translateY(-1px);
}

.nav-new-sale-btn:active {
  transform: translateY(0);
}

/* ─── Sidebar Footer ─── */
.sidebar-footer {
  padding: 12px 16px;
  border-top: 1px solid var(--border-surface);
  position: relative;
}

/* User Profile Area */
.user-profile-area {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px;
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all 0.15s ease;
}

.user-profile-area:hover {
  background: var(--color-panel-2);
}

.user-avatar {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-full);
  background: var(--color-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  flex-shrink: 0;
}

.user-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--color-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.user-role {
  font-size: 0.6875rem;
  color: var(--color-muted);
  text-transform: capitalize;
}

.user-chevron {
  color: var(--color-muted);
  transition: transform 0.2s ease;
  flex-shrink: 0;
}

.user-chevron.open {
  transform: rotate(180deg);
}

/* ─── User Dropdown ─── */
.user-dropdown {
  position: absolute;
  bottom: 100%;
  left: 12px;
  right: 12px;
  background: var(--color-panel);
  border: 1px solid var(--border-surface);
  border-radius: var(--radius-md);
  box-shadow: var(--elevation-3);
  padding: 4px;
  animation: dropUp 0.15s ease-out;
  z-index: 200;
}

@keyframes dropUp {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.user-dropdown-item {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 8px 12px;
  background: none;
  border: none;
  color: var(--color-muted);
  font-size: 0.8125rem;
  font-family: inherit;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all 0.15s ease;
}

.user-dropdown-item:hover {
  background: var(--color-panel-2);
  color: var(--color-text);
}

.user-dropdown-item.text-danger:hover {
  background: var(--red-dim);
  color: var(--color-danger);
}

.user-dropdown-divider {
  height: 1px;
  background: var(--border-surface);
  margin: 4px 0;
}

/* ─── Main Content Area ─── */
.main-content {
  flex: 1;
  margin-left: 252px;
  background: var(--color-bg);
  min-height: 100vh;
  transition: background 0.2s ease;
}

/* ─── Responsive ─── */
@media (max-width: 768px) {
  .sidebar {
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    box-shadow: none;
  }

  .sidebar.open {
    transform: translateX(0);
    box-shadow: var(--elevation-3);
  }

  .main-content {
    margin-left: 0;
  }
}


