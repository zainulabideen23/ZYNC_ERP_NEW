import React from 'react'

export default function Badge({ variant = 'default', children, className = '' }) {
  let bg, text, dot

  switch (variant) {
    case 'paid':
    case 'active':
    case 'confirmed':
    case 'cashier':
    case 'equity':
    case 'approve':
      bg = 'var(--green-dim)'
      text = 'var(--green)'
      dot = 'var(--green)'
      break
    case 'pending':
    case 'billed':
    case 'update':
    case 'liability':
      bg = 'var(--amber-dim)'
      text = 'var(--amber)'
      dot = 'var(--amber)'
      break
    case 'overdue':
    case 'delete':
    case 'admin':
    case 'expense':
    case 'reject':
      bg = 'var(--red-dim)'
      text = 'var(--red)'
      dot = 'var(--red)'
      break
    case 'draft':
    case 'inactive':
    case 'login':
    case 'default':
      bg = 'var(--surface-2)'
      text = 'var(--muted)'
      dot = null
      break
    case 'sale':
    case 'create':
    case 'manager':
    case 'asset':
      bg = 'var(--blue-dim)'
      text = 'var(--blue)'
      dot = 'var(--blue)'
      break
    case 'purchase':
      bg = 'var(--purple-dim)'
      text = 'var(--purple)'
      dot = 'var(--purple)'
      break
    case 'income':
      bg = 'var(--cyan-dim)'
      text = 'var(--cyan)'
      dot = null
      break
    default:
      bg = 'var(--surface-2)'
      text = 'var(--muted)'
      dot = null
  }

  const badgeStyle = {
    backgroundColor: bg,
    color: text,
    borderRadius: '20px',
    fontSize: '11px',
    fontWeight: 500,
    padding: '3px 9px',
    display: 'inline-flex',
    alignItems: 'center',
    gap: '6px',
    border: variant === 'draft' || variant === 'inactive' || variant === 'login' 
            ? '0.5px solid var(--border)' 
            : 'none'
  }

  const dotStyle = {
    width: '5px',
    height: '5px',
    borderRadius: '50%',
    backgroundColor: dot,
    display: 'inline-block'
  }

  return (
    <span style={badgeStyle} className={className}>
      {dot && <span style={dotStyle} />}
      {children}
    </span>
  )
}


