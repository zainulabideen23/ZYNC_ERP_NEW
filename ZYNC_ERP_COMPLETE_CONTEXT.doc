import os
import glob

order = [
    # STEP 1
    "package.json",
    "README.md",
    ".env",
    ".env.example",
    "docker-compose.yml",
    # STEP 2
    "backend/package.json",
    "backend/knexfile.js",
    "backend/.env",
    "backend/.env.example",
    "backend/src/index.js",
    # STEP 3
    "backend/database/migrations/*.js",
    # STEP 4
    "backend/database/seeds/*.js",
    # STEP 5
    "backend/src/config/*.js",
    "backend/src/middleware/*.js",
    # STEP 6
    "backend/src/routes/*.js",
    # STEP 7
    "backend/src/services/*.js",
    # STEP 8
    "backend/src/utils/*.js",
    "backend/src/validators/*.js",
    "backend/src/constants/*.js",
    # STEP 9
    "frontend/package.json",
    "frontend/vite.config.js",
    "frontend/index.html",
    "frontend/src/main.jsx",
    "frontend/src/App.jsx",
    # STEP 10
    "frontend/src/store/*.js",
    "frontend/src/store/*.jsx",
    # STEP 11
    "frontend/src/services/*.js",
    "frontend/src/services/*.jsx",
    # STEP 12
    "frontend/src/pages/**/*.jsx",
    "frontend/src/pages/**/*.js",
    # STEP 13
    "frontend/src/components/**/*.jsx",
    "frontend/src/components/**/*.js",
    # STEP 14
    "frontend/src/utils/*.js",
    "frontend/src/utils/*.jsx",
    # STEP 15
    "backend/scripts/*.js",
    "backend/scripts/*.sh",
    "backend/tests/*.js"
]

out = []
for item in order:
    if '*' in item:
        files = glob.glob(item, recursive=True)
        files.sort()
        for f in files:
            if os.path.isfile(f):
                try:
                    with open(f, 'r', encoding='utf-8') as file:
                        c = file.read()
                        out.append(f"--- FILE: {f} ---\n{c}\n")
                except:
                    pass
    else:
        if os.path.isfile(item):
            try:
                with open(item, 'r', encoding='utf-8') as file:
                    c = file.read()
                    out.append(f"--- FILE: {item} ---\n{c}\n")
            except:
                pass

with open('bundled_codebase.txt', 'w', encoding='utf-8') as f:
    f.write('\n'.join(out))

print("Bundled into bundled_codebase.txt. Total lines:", sum(1 for _ in open('bundled_codebase.txt', encoding='utf-8')))


