import React from 'react'
import { Search, X, Download } from 'lucide-react'

// Example usage:
// <FilterBar 
//   onSearch={setSearch} 
//   searchPlaceholder="Search invoices..."
//   statusOptions={[{value: 'paid', label: 'Paid'}, ...]}
//   onStatusChange={setStatus}
//   showDateRange={true}
//   onDateChange={setDates}
//   onClear={clearAll}
//   hasActiveFilters={true}
//   onExport={exportData}
// />
export default function FilterBar({
  searchValue,
  onSearchChange,
  searchPlaceholder = 'Search...',
  
  statusValue,
  onStatusChange,
  statusOptions = [], // {value, label}
  
  showDateRange = false,
  startDate,
  endDate,
  onStartDateChange,
  onEndDateChange,

  onClear,
  hasActiveFilters = false,

  onExport
}) {
  const controlClass = `h-[32px] rounded-[var(--r6)] bg-[var(--surface-2)] border-[0.5px] border-[var(--border-2)] text-[12px] text-[var(--text)] px-[10px] focus:outline-none focus:border-[var(--blue)] transition-colors`

  return (
    <div className="flex items-center gap-[8px] px-[16px] py-[12px] border-b-[0.5px] border-b-[var(--border)] w-full overflow-x-auto">
      
      {/* 1. Search */}
      {onSearchChange !== undefined && (
        <div className="relative min-w-[200px]">
          <Search size={14} className="absolute left-[10px] top-1/2 -translate-y-1/2 text-[var(--muted)]" />
          <input 
            type="text" 
            placeholder={searchPlaceholder}
            value={searchValue || ''}
            onChange={(e) => onSearchChange(e.target.value)}
            className={`${controlClass} pl-[32px] w-full placeholder-[rgba(122,135,153,0.5)]`}
          />
        </div>
      )}

      {/* 2. Status Select */}
      {statusOptions.length > 0 && onStatusChange !== undefined && (
        <select 
          value={statusValue || ''}
          onChange={(e) => onStatusChange(e.target.value)}
          className={`${controlClass} min-w-[120px]`}
        >
          <option value="">All Statuses</option>
          {statusOptions.map(opt => (
            <option key={opt.value} value={opt.value}>{opt.label}</option>
          ))}
        </select>
      )}

      {/* 3. Date Range */}
      {showDateRange && (
        <div className="flex items-center gap-2">
          <input 
            type="date"
            value={startDate || ''}
            onChange={(e) => onStartDateChange && onStartDateChange(e.target.value)}
            style={{ colorScheme: 'dark' }}
            className={controlClass}
          />
          <span className="text-[var(--muted)] text-[12px]">to</span>
          <input 
            type="date"
            value={endDate || ''}
            onChange={(e) => onEndDateChange && onEndDateChange(e.target.value)}
            style={{ colorScheme: 'dark' }}
            className={controlClass}
          />
        </div>
      )}

      {/* 4. Clear */}
      {hasActiveFilters && onClear && (
        <button 
          onClick={onClear}
          className="h-[32px] rounded-[var(--r6)] bg-transparent border-none text-[var(--muted)] px-[10px] flex items-center gap-[6px] hover:bg-[var(--surface-2)] hover:text-[var(--text)] transition-colors text-[12px] font-medium"
        >
          <X size={14} /> Clear
        </button>
      )}

      {/* 5. Spacer */}
      <div className="flex-1"></div>

      {/* 6. Export */}
      {onExport && (
        <button 
          onClick={onExport}
          className={`${controlClass} flex items-center gap-[6px] font-medium hover:bg-[var(--surface-3)] ml-auto`}
        >
          <Download size={14} /> Export
        </button>
      )}

    </div>
  )
}


