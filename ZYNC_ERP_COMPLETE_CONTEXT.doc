/* ============================================
   DASHBOARD — Modern SaaS Redesign
   Clean, light, professional
   ============================================ */

/* ─── Animations ─── */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes wave {
  0%, 100% { transform: rotate(0deg); }
  10% { transform: rotate(14deg); }
  20% { transform: rotate(-8deg); }
  30% { transform: rotate(14deg); }
  40% { transform: rotate(-4deg); }
  50% { transform: rotate(10deg); }
  60%, 100% { transform: rotate(0deg); }
}

/* ─── Breadcrumbs ─── */
.dashboard-breadcrumbs {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.8125rem;
  color: var(--color-muted);
  margin-bottom: var(--space-3);
}

.breadcrumb-link {
  color: var(--color-muted);
  text-decoration: none;
  transition: color 0.15s ease;
}

.breadcrumb-link:hover {
  color: var(--color-accent);
  opacity: 1;
}

.breadcrumb-sep {
  color: var(--color-hint);
}

.breadcrumb-current {
  color: var(--color-text);
  font-weight: 500;
}

/* ─── Greeting Banner ─── */
.dashboard-greeting {
  background: var(--color-panel);
  border: 1px solid var(--border-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-4);
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: var(--elevation-1);
  animation: fadeInUp 0.4s ease-out;
}

.greeting-text h1 {
  font-size: 1.375rem;
  font-weight: 700;
  margin: 0 0 4px 0;
  color: var(--color-text);
  background: none;
  -webkit-text-fill-color: unset;
}

.greeting-wave {
  font-size: 1.375rem;
  display: inline-block;
  animation: wave 2s ease-in-out infinite;
  transform-origin: 70% 70%;
}

.greeting-date {
  color: var(--color-muted);
  font-size: 0.8125rem;
}

.greeting-right {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

/* Search Bar */
.dashboard-search {
  position: relative;
  width: 280px;
}

.dashboard-search-icon {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--color-hint);
  pointer-events: none;
}

.dashboard-search input {
  width: 100%;
  padding: 9px 14px 9px 38px;
  background: var(--color-panel-2);
  border: 1px solid var(--border-surface);
  border-radius: var(--radius-full);
  color: var(--color-text);
  font-size: 0.8125rem;
  font-family: inherit;
  transition: all 0.2s ease;
}

.dashboard-search input::placeholder {
  color: var(--color-hint);
}

.dashboard-search input:focus {
  outline: none;
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  background: var(--color-panel);
}

/* Notification Bell */
.notification-bell {
  position: relative;
  background: var(--color-panel-2);
  border: 1px solid var(--border-surface);
  border-radius: var(--radius-full);
  padding: 8px;
  cursor: pointer;
  color: var(--color-muted);
  transition: all 0.15s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notification-bell:hover {
  color: var(--color-text);
  background: var(--color-panel-3);
}

.notification-badge {
  position: absolute;
  top: -4px;
  right: -4px;
  background: var(--color-danger);
  color: white;
  font-size: 0.625rem;
  font-weight: 700;
  min-width: 18px;
  height: 18px;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 4px;
  border: 2px solid var(--color-panel);
}

/* Greeting Stat Chip */
.greeting-stat {
  text-align: right;
  background: var(--blue-dim);
  padding: 10px 18px;
  border-radius: var(--radius-lg);
  border: 1px solid rgba(37, 99, 235, 0.1);
}

.greeting-stat .value {
  font-size: 1.375rem;
  font-weight: 700;
  color: var(--color-accent);
  line-height: 1.2;
  font-family: var(--font-sans);
}

.greeting-stat .label {
  font-size: 0.6875rem;
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 2px;
  font-weight: 500;
}

/* ─── Quick Stats Row ─── */
.quick-stats-row {
  display: flex;
  gap: 12px;
  margin-bottom: var(--space-4);
  animation: fadeInUp 0.4s ease-out 0.1s both;
  flex-wrap: wrap;
}

.quick-stat-item {
  flex: 1;
  min-width: 200px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  background: var(--color-panel);
  border: 1px solid var(--border-surface);
  border-radius: var(--radius-md);
  font-size: 0.8125rem;
  color: var(--color-muted);
  transition: all 0.15s ease;
  cursor: pointer;
}

.quick-stat-item:hover {
  border-color: var(--color-accent);
  background: var(--color-accent-light);
  box-shadow: var(--elevation-1);
}

.quick-stat-item .qs-icon {
  font-size: 1rem;
  flex-shrink: 0;
}

.quick-stat-item .qs-label {
  color: var(--color-muted);
  font-weight: 500;
}

.quick-stat-item .qs-value {
  color: var(--color-text);
  font-weight: 600;
  margin-left: 4px;
}

/* ─── KPI Grid ─── */
.dashboard-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

@media (min-width: 480px) {
  .dashboard-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (min-width: 768px) {
  .dashboard-grid { grid-template-columns: repeat(3, 1fr); }
}

@media (min-width: 1280px) {
  .dashboard-grid { grid-template-columns: repeat(5, 1fr); }
}

/* ─── KPI Cards ─── */
.kpi-card {
  background: var(--color-panel);
  border: 1px solid var(--border-surface);
  border-radius: var(--radius-lg);
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 140px;
  position: relative;
  overflow: hidden;
  transition: all 0.2s ease;
  box-shadow: var(--elevation-1);
  animation: fadeInUp 0.4s ease-out both;
}

.kpi-card:nth-child(1) { animation-delay: 0.05s; }
.kpi-card:nth-child(2) { animation-delay: 0.1s; }
.kpi-card:nth-child(3) { animation-delay: 0.15s; }
.kpi-card:nth-child(4) { animation-delay: 0.2s; }
.kpi-card:nth-child(5) { animation-delay: 0.25s; }

.kpi-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--elevation-hover);
}

.kpi-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--space-2);
}

.kpi-label {
  font-size: 0.75rem;
  color: var(--color-muted);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.kpi-icon {
  font-size: 1.1rem;
  opacity: 0.9;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
}

.kpi-value {
  font-size: 1.625rem;
  font-weight: 700;
  color: var(--color-text);
  margin: 4px 0;
  font-family: var(--font-sans);
  word-break: break-word;
  line-height: 1.2;
}

.kpi-value.zero-value {
  color: var(--color-hint);
  font-weight: 400;
}

.kpi-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.75rem;
  color: var(--color-muted);
  margin-top: auto;
}

/* Trend Badge */
.trend-badge {
  padding: 2px 8px;
  border-radius: var(--radius-full);
  font-weight: 600;
  font-size: 0.6875rem;
  display: inline-flex;
  align-items: center;
  gap: 3px;
}

.trend-up {
  background: var(--green-dim);
  color: var(--color-success);
}

.trend-down {
  background: var(--red-dim);
  color: var(--color-danger);
}

.trend-neutral {
  background: var(--color-panel-2);
  color: var(--color-muted);
}

.kpi-subtitle {
  font-size: 0.6875rem;
  color: var(--color-muted);
}

.kpi-timestamp {
  font-size: 0.6875rem;
  color: var(--color-hint);
}

/* KPI Top Accent Borders */
.kpi-sales     { border-top: 3px solid var(--color-success); }
.kpi-cash      { border-top: 3px solid var(--color-accent); }
.kpi-profit    { border-top: 3px solid #8B5CF6; }
.kpi-receivable { border-top: 3px solid var(--color-warning); }
.kpi-payable   { border-top: 3px solid var(--color-danger); }

/* ─── Chart Section ─── */
.chart-section {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-4);
  margin-bottom: var(--space-4);
  animation: fadeInUp 0.4s ease-out 0.3s both;
}

@media (min-width: 1024px) {
  .chart-section { grid-template-columns: 2fr 1fr; }
}

.chart-card {
  background: var(--color-panel);
  border: 1px solid var(--border-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  box-shadow: var(--elevation-1);
  display: flex;
  flex-direction: column;
  transition: box-shadow 0.2s ease;
}

.chart-card:hover {
  box-shadow: var(--elevation-2);
}

.chart-card.fixed-height {
  height: 420px;
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-4);
  flex-shrink: 0;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.chart-title {
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--color-text);
}

.chart-legend {
  display: flex;
  gap: 8px;
}

.legend-pill {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.6875rem;
  color: var(--color-muted);
  padding: 4px 10px;
  background: var(--color-panel-2);
  border-radius: var(--radius-full);
  white-space: nowrap;
  flex-shrink: 0;
  font-weight: 500;
}

.legend-color {
  width: 8px;
  height: 8px;
  border-radius: 2px;
}

/* Time Range Selector (Pill Tabs) */
.time-range-selector {
  display: flex;
  gap: 2px;
  background: var(--color-panel-2);
  border-radius: var(--radius-full);
  padding: 3px;
}

.time-range-btn {
  padding: 4px 12px;
  border: none;
  background: transparent;
  color: var(--color-muted);
  font-size: 0.6875rem;
  font-weight: 500;
  border-radius: var(--radius-full);
  cursor: pointer;
  transition: all 0.15s ease;
  font-family: inherit;
  white-space: nowrap;
}

.time-range-btn:hover {
  color: var(--color-text);
}

.time-range-btn.active {
  background: var(--color-accent);
  color: white;
  box-shadow: var(--elevation-1);
}

.view-all-btn {
  font-size: 0.75rem;
  color: var(--color-accent);
  padding: 4px 12px;
  border: 1px solid var(--border-surface);
  border-radius: var(--radius-full);
  transition: all 0.15s ease;
  text-decoration: none;
  font-weight: 500;
}

.view-all-btn:hover {
  background: var(--blue-dim);
  border-color: var(--color-accent);
  opacity: 1;
}

/* ─── Dual Bar Chart ─── */
.dual-bar-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 250px;
  padding-top: 20px;
  gap: 8px;
  position: relative;
}

.chart-bg-lines {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  pointer-events: none;
  z-index: 0;
  padding-bottom: 24px;
}

.chart-line {
  border-top: 1px dashed var(--border-surface);
  width: 100%;
}

.chart-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  height: 100%;
  justify-content: flex-end;
  position: relative;
  cursor: pointer;
  z-index: 1;
}

.bars-group {
  display: flex;
  gap: 3px;
  align-items: flex-end;
  width: 100%;
  height: 100%;
  justify-content: center;
}

.bar {
  width: 16px;
  border-radius: 4px 4px 0 0;
  transition: height 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.15s, filter 0.15s;
  min-height: 4px;
}

.bar-sales {
  background: var(--color-accent);
}

.bar-purchase {
  background: var(--color-danger);
  opacity: 0.7;
}

.chart-col:hover .bar {
  opacity: 1;
  filter: brightness(1.1);
}

.chart-col:hover .tooltip {
  opacity: 1;
  transform: translateY(-5px);
  visibility: visible;
}

.chart-label {
  font-size: 0.6875rem;
  color: var(--color-hint);
  margin-top: 4px;
}

.tooltip {
  position: absolute;
  bottom: 100%;
  background: var(--color-panel);
  border: 1px solid var(--border-surface);
  padding: 10px;
  border-radius: var(--radius-md);
  font-size: 0.75rem;
  white-space: nowrap;
  opacity: 0;
  visibility: hidden;
  transition: all 0.15s ease;
  pointer-events: none;
  z-index: 10;
  box-shadow: var(--elevation-3);
  color: var(--color-text);
}

.chart-empty {
  height: 180px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--color-muted);
  font-size: 0.875rem;
  border: 1px dashed var(--border-surface);
  border-radius: var(--radius-lg);
  gap: 12px;
}

.empty-cta-btn {
  background: var(--blue-dim);
  color: var(--color-accent);
  padding: 6px 14px;
  border-radius: var(--radius-full);
  font-size: 0.8125rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.15s ease;
}

.empty-cta-btn:hover {
  background: var(--color-accent);
  color: white;
  opacity: 1;
}

/* ─── Panels Grid ─── */
.panels-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-4);
  margin-bottom: var(--space-4);
  animation: fadeInUp 0.4s ease-out 0.4s both;
}

@media (min-width: 768px) {
  .panels-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (min-width: 1100px) {
  .panels-grid { grid-template-columns: repeat(3, 1fr); }
}

/* ─── Timeline Feed ─── */
.timeline {
  position: relative;
  padding-left: 16px;
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow-y: auto;
  padding-right: 6px;
}

.timeline::-webkit-scrollbar { width: 4px; }
.timeline::-webkit-scrollbar-track { background: transparent; }
.timeline::-webkit-scrollbar-thumb { background: var(--border-surface); border-radius: 4px; }
.timeline::-webkit-scrollbar-thumb:hover { background: var(--color-muted); }

.timeline::before {
  content: '';
  position: absolute;
  left: 7px;
  top: 0;
  bottom: 0;
  width: 2px;
  background: var(--border-surface);
}

.timeline-item {
  position: relative;
  padding: 12px 0 12px 20px;
  border-bottom: 1px solid var(--border-surface);
  transition: background 0.15s ease;
}

.timeline-item:last-child { border-bottom: none; }

.timeline-item:hover {
  background: var(--color-panel-2);
}

.timeline-dot {
  position: absolute;
  left: -1px;
  top: 16px;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  border: 2px solid var(--color-panel);
  z-index: 2;
  box-shadow: 0 0 0 2px var(--border-surface);
}

.dot-sale { background: var(--color-success); }
.dot-purchase { background: var(--color-accent); }

.timeline-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tl-info { display: flex; flex-direction: column; gap: 2px; }

.tl-icon-label {
  display: flex;
  align-items: center;
  gap: 6px;
}

.tl-type-icon { font-size: 0.9rem; }

.tl-party {
  font-weight: 600;
  font-size: 0.875rem;
  color: var(--color-text);
}

.tl-ref {
  font-size: 0.6875rem;
  color: var(--color-muted);
  font-family: var(--font-mono);
}

.tl-meta {
  text-align: right;
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 80px;
}

.tl-amount {
  font-family: var(--font-sans);
  font-weight: 700;
  font-size: 0.875rem;
}

.tl-time {
  font-size: 0.6875rem;
  color: var(--color-hint);
}

/* ─── Top Products ─── */
.product-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.top-product-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 4px 0;
  transition: all 0.15s ease;
}

.rank-badge {
  width: 26px;
  height: 26px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.6875rem;
  font-weight: 700;
  flex-shrink: 0;
}

.top-1 { background: var(--color-accent); color: white; }
.top-2 { background: var(--blue-dim); color: var(--color-accent); }
.top-3 { background: var(--color-panel-2); color: var(--color-muted); }
.top-rest { background: transparent; color: var(--color-muted); border: 1px solid var(--border-surface); }

.prod-details { flex: 1; }

.prod-header {
  display: flex;
  justify-content: space-between;
  font-size: 0.8125rem;
  margin-bottom: 6px;
}

.prod-sold-count {
  font-size: 0.75rem;
  color: var(--color-muted);
  font-weight: 500;
}

.progress-track {
  height: 6px;
  background: var(--color-panel-2);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-accent), #60a5fa);
  border-radius: var(--radius-full);
  transition: width 0.6s ease;
}

/* ─── Donut Chart ─── */
.donut-wrapper {
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 16px 0;
}

.donut-chart {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.donut-hole {
  position: absolute;
  inset: 22px;
  background: var(--color-panel);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.donut-total-label {
  font-size: 0.625rem;
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.donut-total-value {
  font-size: 1.0625rem;
  font-weight: 700;
  color: var(--color-text);
}

.donut-legend {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.legend-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.8125rem;
}

.legend-cat {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--color-text);
}

.color-swatch {
  width: 10px;
  height: 10px;
  border-radius: 3px;
  flex-shrink: 0;
}

/* ─── Inventory Gauge ─── */
.gauge-container {
  background: var(--color-panel-2);
  height: 10px;
  border-radius: var(--radius-full);
  display: flex;
  overflow: hidden;
  margin: 16px 0 8px 0;
  text-decoration: none;
}

.gauge-seg {
  height: 100%;
  transition: width 0.5s ease;
  cursor: pointer;
  opacity: 0.85;
}

.gauge-seg:hover { opacity: 1; }
.seg-healthy { background: var(--color-success); }
.seg-low { background: var(--color-warning); }
.seg-out { background: var(--color-danger); }

.gauge-legend {
  display: flex;
  justify-content: flex-start;
  gap: 16px;
  font-size: 0.75rem;
  color: var(--color-muted);
  margin-top: 12px;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  transition: color 0.15s ease;
  text-decoration: none;
  color: var(--color-muted);
}

.legend-item:hover {
  color: var(--color-text);
  opacity: 1;
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

/* ─── Pending Actions ─── */
.actions-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.pending-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  background: var(--color-panel-2);
  border-radius: var(--radius-md);
  border-left: 3px solid transparent;
  cursor: pointer;
  transition: all 0.15s ease;
  text-decoration: none;
  color: var(--color-text);
}

.pending-item:hover {
  transform: translateX(4px);
  background: var(--color-panel-3);
  opacity: 1;
}

.pending-item.urgent { border-left-color: var(--color-danger); }
.pending-item.warning { border-left-color: var(--color-warning); }

.count-badge {
  background: var(--color-panel-3);
  padding: 2px 8px;
  border-radius: var(--radius-full);
  font-size: 0.6875rem;
  font-weight: 700;
}

.urgent .count-badge { background: var(--red-dim); color: var(--color-danger); }
.warning .count-badge { background: var(--amber-dim); color: var(--color-warning); }

.chevron {
  font-size: 1.2rem;
  color: var(--color-muted);
  margin-left: 8px;
}

/* ─── Skeleton Loaders ─── */
.skeleton {
  background: linear-gradient(90deg, var(--color-panel-2) 25%, var(--color-panel-3) 50%, var(--color-panel-2) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: var(--radius-md);
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.sk-card { height: 140px; border-radius: var(--radius-lg); }
.sk-chart { height: 200px; border-radius: var(--radius-lg); }

/* ─── Theme Toggle ─── */
.theme-toggle {
  background: var(--color-panel-2);
  border: 1px solid var(--border-surface);
  border-radius: var(--radius-full);
  padding: 8px;
  cursor: pointer;
  color: var(--color-muted);
  transition: all 0.15s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
}

.theme-toggle:hover {
  color: var(--color-text);
  background: var(--color-panel-3);
}

/* ─── Notification Dropdown ─── */
.notification-dropdown {
  position: absolute;
  right: 0;
  top: calc(100% + 8px);
  width: 300px;
  background: var(--color-panel);
  border: 1px solid var(--border-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--elevation-3);
  z-index: 50;
  overflow: hidden;
}

.notification-dropdown-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-bottom: 1px solid var(--border-surface);
}

.notification-dropdown-header span {
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--color-text);
}

.notification-dropdown-close {
  background: none;
  border: none;
  color: var(--color-muted);
  cursor: pointer;
  padding: 2px;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  transition: color 0.15s;
}

.notification-dropdown-close:hover {
  color: var(--color-text);
}

.notification-dropdown-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 16px;
  background: none;
  border: none;
  text-align: left;
  cursor: pointer;
  transition: background 0.15s;
  font-family: inherit;
  color: var(--color-text);
}

.notification-dropdown-item:hover {
  background: var(--color-panel-2);
}

.notification-dropdown-item .n-icon {
  flex-shrink: 0;
  color: var(--color-muted);
}

.notification-dropdown-item .n-icon.yellow { color: var(--color-warning); }
.notification-dropdown-item .n-icon.blue { color: var(--color-accent); }
.notification-dropdown-item .n-icon.purple { color: #8B5CF6; }

.notification-dropdown-item span {
  font-size: 0.8125rem;
  color: var(--color-text-dim);
}

/* ─── Activity Feed (inline-styled items) ─── */
.activity-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 10px 8px;
  border-radius: var(--radius-md);
  transition: background 0.15s ease;
  cursor: default;
}

.activity-item:hover {
  background: var(--color-panel-2);
}

.activity-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-top: 8px;
  flex-shrink: 0;
}

.activity-icon-box {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--color-panel-2);
}

.activity-text {
  flex: 1;
  min-width: 0;
}

.activity-text p {
  font-size: 0.8125rem;
  color: var(--color-text);
  line-height: 1.4;
  margin: 0;
}

.activity-text .username {
  font-weight: 700;
  color: var(--color-text);
}

.activity-text .action {
  color: var(--color-muted);
}

.activity-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 2px;
}

.activity-amount {
  font-size: 0.75rem;
  font-weight: 700;
}

.activity-amount.positive { color: var(--color-success); }
.activity-amount.negative { color: var(--color-danger); }

.activity-time {
  font-size: 0.6875rem;
  color: var(--color-hint);
}

/* ─── Responsive Greeting ─── */
@media (max-width: 768px) {
  .dashboard-greeting {
    flex-direction: column;
    gap: var(--space-3);
    align-items: stretch;
  }

  .greeting-right {
    flex-direction: column;
    gap: var(--space-2);
  }

  .dashboard-search {
    width: 100%;
  }

  .greeting-stat {
    text-align: center;
  }

  .quick-stats-row {
    flex-direction: column;
  }
}


================================================================================
File: frontend/src/pages/Dashboard.css.bak
