# Frontend API URLs
# Example: https://your-backend-domain.com/api
VITE_API_URL=http://localhost:3001/api

# Example: https://your-backend-domain.com/platform
VITE_PLATFORM_API_URL=http://localhost:3001/platform

# Must match backend PLATFORM_ADMIN_SECRET for platform routes
VITE_PLATFORM_SECRET=change-this-to-a-strong-secret
